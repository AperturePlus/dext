# dext environment configuration. Copy to `.env` and fill in.
# `.env` is gitignored; this example is committed. Settings live in src/dext/config.py.
# Only DEEPSEEK_API_KEY matters, and only from SP5 onward — SP1–SP4 read none of this.

# ── LLM (required before SP5; UNPREFIXED name) ───────────────────────────────
DEEPSEEK_API_KEY=

# ── LLM tuning (optional; DEXT_-prefixed) ────────────────────────────────────
# DEXT_LLM_BASE_URL=https://api.deepseek.com
# DEXT_LLM_MODEL=deepseek-v4-flash
# DEXT_LLM_ENABLE_THINKING=true
# DEXT_LLM_REASONING_EFFORT=high
# DEXT_LLM_REASONING_EFFORT_RETRY=max
# DEXT_LLM_MAX_PAGE_TOKENS=24000
# DEXT_DECISION_WORKERS=3
# DEXT_EXTRACT_WORKERS=3
# DEXT_INVALID_JSON_MAX_RETRY=2

# ── Paths ────────────────────────────────────────────────────────────────────
# DEXT_DATA_DIR=data/universities
# DEXT_SEED_PATH=entrances.yaml

# ── Fetch bridge (browser ↔ backend; fixed-contract port) ────────────────────
# DEXT_BRIDGE_HOST=127.0.0.1
# DEXT_BRIDGE_PORT=21520
# DEXT_FETCH_TIMEOUT_SECONDS=60

# ── Scheduling / retry ───────────────────────────────────────────────────────
# DEXT_MAX_DEPTH=4
# DEXT_MAX_ATTEMPTS=3
# DEXT_FOLLOWUP_PAGE_LIMIT=36
# DEXT_ATTEMPT_PENALTY=5.0

# ── Probes (off-channel aiohttp side-probes; overview §7) ────────────────────
# Each probes a candidate URL *before* it reaches the human browser fetcher.
# Disabling a probe = the CLI does NOT construct it (passes None), so that probe
# never defers/skips/drops — a coarse escape hatch when an entire site times out
# from the backend's raw GET yet loads fine in the browser. A probe *timeout* is
# already non-blocking regardless (PROBE_TIMEOUT → keep pending → fetch anyway).
# DEXT_PROBE_REDIRECT_ENABLED=true
# DEXT_PROBE_STATUS_ENABLED=true

# ── Logging ──────────────────────────────────────────────────────────────────
# DEXT_LOG_LEVEL=INFO
